{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "connectorNamespaceLocation": { "value": "${CONNECTOR_NAMESPACE_LOCATION=westcentralus}" },
    "userPrincipalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "plannerGroupId": { "value": "${PLANNER_GROUP_ID}" },
    "plannerPlanId": { "value": "${PLANNER_PLAN_ID}" },
    "plannerEnableAssignedToMe": { "value": "${PLANNER_ENABLE_ASSIGNED_TO_ME=false}" }
  }
}
