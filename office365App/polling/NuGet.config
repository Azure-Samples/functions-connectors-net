<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="upstream-public" value="https://pkgs.dev.azure.com/azfunc/public/_packaging/upstream-public/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="upstream-public">
      <package pattern="Microsoft.Azure.Functions.Worker.Extensions.Connector" />
      <package pattern="Microsoft.Azure.Functions.Extensions.Connector" />
      <package pattern="Azure.Connectors.Sdk" />
    </packageSource>
  </packageSourceMapping>
</configuration>
