    "OnNewItemTriggerConfigName": "sharepoint-onnewitem",
    "OnUpdatedItemTriggerConfigName": "sharepoint-onupdateditem",
    "OnChangedItemTriggerConfigName": "sharepoint-onchangeditem",
    "OnDeletedItemTriggerConfigName": "sharepoint-ondeleteditem",
    "OnDeletedFileTriggerConfigName": "sharepoint-ondeletedfile",
    "OnFormSubmittedTriggerConfigName": "sharepoint-onformsubmitted",
    "OnFileClassifiedTriggerConfigName": "sharepoint-onfileclassified",
    "OnRecurringDigestTriggerConfigName": "sharepoint-onrecurringdigest",
    "AzureWebJobs.OnNewFile.Disabled": "false",
    "AzureWebJobs.OnUpdatedFile.Disabled": "false",
    "AzureWebJobs.OnNewItem.Disabled": "false",
    "AzureWebJobs.OnUpdatedItem.Disabled": "false",
    "AzureWebJobs.OnChangedItem.Disabled": "false",
    "AzureWebJobs.OnDeletedItem.Disabled": "true",
    "AzureWebJobs.OnDeletedFile.Disabled": "true",
    "AzureWebJobs.OnFormSubmitted.Disabled": "true",
    "AzureWebJobs.OnFileClassified.Disabled": "true",
    "AzureWebJobs.OnRecurringDigest.Disabled": "true"
  }
